CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
# ESP32-S31-WROOM-3-N16R16V: 16 MB quad flash, 16 MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# No Linux on this board: tiny386's own partition table (FIRMWARE-PLAN 5.7).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# On for the first boot of each new board: the module's PSRAM runs at
# 250 MHz, above the 200 MHz its datasheet guarantees (FIRMWARE-PLAN 5.1).
# Turn it off once a board has passed.
CONFIG_SPIRAM_MEMTEST=y
# GPIO33/34 are RGB data pins and also the USB Serial/JTAG pins: UART0 only
# (CH340C on the board's USB-C).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
# 100 ticks a second: vga_task paces itself in whole ticks (LCD_FRAME_MS), and
# core 1 takes ten times fewer tick interrupts (FIRMWARE-PLAN section 4).
CONFIG_FREERTOS_HZ=100
# i386_task never yields on core 1.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# The card's first FAT partition at /sdcard and up to three more at
# /sdcardN (storage.c), and their labels (to find the one called WIN9X).
CONFIG_FATFS_VOLUME_COUNT=4
CONFIG_FATFS_USE_LABEL=y
# FatFs's fast seek: disk_image.c maps each disk image's clusters once,
# so that a seek reads no FAT (ESP-IDF's VFS also maps files opened read
# only, with CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE words).
CONFIG_FATFS_USE_FASTSEEK=y
# A crash halts with the crash screen on the picture (crash.c) instead of
# restarting at once.
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
# app_main brings up the picture, the HDMI transmitter and the console,
# mounts the card and reads the ini.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# esp_cache_msync() writes back in pieces, so that core 0's interrupts are
# not held off for a whole frame buffer.
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS=y
# Needed with it: ESP-IDF 188e3e55bb gives this no default for esp32s31, and
# kconfgen stops on the empty hex value.  32 KiB, the ESP32-S3 default.
CONFIG_ESP_MM_CACHE_MSYNC_C2M_CHUNKED_OPS_MAX_LEN=0x8000
# No time, date or build path in the images (see main/CMakeLists.txt).
CONFIG_APP_REPRODUCIBLE_BUILD=y
