+/* perfport's harness: in time order among those still to come, so that a
+   dialog's Enter is not left behind a -keyfile's later keys */
+static void put_key(struct key_ev e)
+{
+	int i = nkeys++;
+	while (i > next_key && keys[i - 1].t > e.t) {
+		keys[i] = keys[i - 1];
+		i--;
+	}
+	keys[i] = e;
+}
