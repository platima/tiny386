+/* ==== perfport: the host's part of the information port ==== */
+#ifdef TINY386_PERFPORT
+static unsigned pp_flushes;             /* the run loop's ide_flush() calls */
+/* the last whole virtual second, as speed.c counts on the board: running
+   is the guest's instructions, halted the idle steps' worth */
+static uint64_t pp_win_t0, pp_win_insns, pp_win_idle;
+static uint32_t pp_kips, pp_halt_pct, pp_seconds;
+static void pp_window(uint64_t t)
+{
+	if (t - pp_win_t0 < 1000000)
+		return;
+	uint64_t di = guest_insns() - pp_win_insns, dh = idle_insns - pp_win_idle;
+	uint64_t run_us = di * 1000000ull / opt_ips, halt_us = dh * 1000000ull / opt_ips;
+	pp_kips = run_us ? (uint32_t) (di * 1000 / run_us) : 0;
+	pp_halt_pct = run_us + halt_us ? (uint32_t) (halt_us * 100 / (run_us + halt_us)) : 0;
+	pp_seconds++;
+	pp_win_t0 = t;
+	pp_win_insns = guest_insns();
+	pp_win_idle = idle_insns;
+}
+
+extern volatile unsigned ide_activity __attribute__((weak));
+extern volatile unsigned emulink_activity __attribute__((weak));
+
+static void pp_fill(void *opaque, uint32_t *v, uint32_t *ok)
+{
+	(void) opaque;
+	uint64_t now = vnow_us();
+	PERFPORT_PUT(v, ok, PP_I_SOURCE, PP_SOURCE_HARNESS);
+	PERFPORT_PUT(v, ok, PP_I_UPTIME_MS, (uint32_t) (now / 1000));
+	PERFPORT_PUT(v, ok, PP_I_PC_UPTIME_MS,
+		     (uint32_t) ((uint32_t) now - (uint32_t) g_pc->boot_start_time) / 1000);
+	uint64_t n = guest_insns();
+	PERFPORT_PUT(v, ok, PP_I_INSNS_LO, (uint32_t) n);
+	PERFPORT_PUT(v, ok, PP_I_INSNS_HI, (uint32_t) (n >> 32));
+	PERFPORT_PUT(v, ok, PP_I_KIPS, pp_kips);
+	PERFPORT_PUT(v, ok, PP_I_HALT_PCT, pp_halt_pct);
+	PERFPORT_PUT(v, ok, PP_I_RUN_MS, (uint32_t) (n * 1000 / opt_ips));
+	PERFPORT_PUT(v, ok, PP_I_HALT_MS, (uint32_t) (idle_insns * 1000 / opt_ips));
+	PERFPORT_PUT(v, ok, PP_I_SECONDS, pp_seconds);
+	if (opt_vga_ms > 0)
+		PERFPORT_PUT(v, ok, PP_I_FRAME_MS, (uint32_t) opt_vga_ms);
+	/* the disk: through the card's FatFs as on the board (-card), else the
+	   host's stdio, counted by iohook.c */
+#ifdef PCR_HAVE_DISK_IMAGE
+	if (pcr_card_image && disk_image_get_stats) {
+		struct disk_image_stats d;
+		disk_image_get_stats(&d, false);
+		PERFPORT_PUT(v, ok, PP_I_DISK_READS, d.reads);
+		PERFPORT_PUT(v, ok, PP_I_DISK_WRITES, d.writes);
+		PERFPORT_PUT(v, ok, PP_I_DISK_READ_SECTORS, d.rsectors);
+		PERFPORT_PUT(v, ok, PP_I_DISK_WRITE_SECTORS, d.wsectors);
+		PERFPORT_PUT(v, ok, PP_I_DISK_BUSY_US, d.busy_us);
+		PERFPORT_PUT(v, ok, PP_I_DISK_LONGEST_US, d.longest_us);
+		PERFPORT_PUT(v, ok, PP_I_DISK_OVER_TICK, d.over_tick);
+		PERFPORT_PUT(v, ok, PP_I_DISK_ERRORS, d.errors);
+		PERFPORT_PUT(v, ok, PP_I_DISK_RECOVERED, d.recovered);
+	} else
+#endif
+	{
+		PERFPORT_PUT(v, ok, PP_I_DISK_READS, pcr_io.reads);
+		PERFPORT_PUT(v, ok, PP_I_DISK_WRITES, pcr_io.writes);
+		PERFPORT_PUT(v, ok, PP_I_DISK_READ_SECTORS, pcr_io.rbytes / 512);
+		PERFPORT_PUT(v, ok, PP_I_DISK_WRITE_SECTORS, pcr_io.wbytes / 512);
+		PERFPORT_PUT(v, ok, PP_I_DISK_BUSY_US, stall_ns_disk / 1000);
+		PERFPORT_PUT(v, ok, PP_I_DISK_ERRORS, pcr_io.errors);
+	}
+	PERFPORT_PUT(v, ok, PP_I_DISK_REFUSED, ide_error_count ? ide_error_count() : 0);
+	PERFPORT_PUT(v, ok, PP_I_DISK_FLUSHES, pp_flushes);
+	if (&ide_activity && &emulink_activity)
+		PERFPORT_PUT(v, ok, PP_I_DISK_ACTIVITY, ide_activity + emulink_activity);
+	perfport_put_text(v, ok, PP_I_FIRMWARE, "pc-harness");
+	perfport_put_text(v, ok, PP_I_BOARD, "PC harness, " HARNESS_FLAVOUR);
+}
+
+/* the port read as a guest reads it: a snapshot, then every index */
+static void pp_read(uint32_t *v)
+{
+	perfport_io_write(g_pc, PP_PORT_CMD - PP_PORT_BASE, PP_CMD_SNAPSHOT, 2);
+	for (int i = 0; i < PP_COUNT; i++) {
+		perfport_io_write(g_pc, 0, (uint32_t) i, 2);
+		v[i] = perfport_io_read(g_pc, PP_PORT_DATA - PP_PORT_BASE, 4);
+	}
+}
