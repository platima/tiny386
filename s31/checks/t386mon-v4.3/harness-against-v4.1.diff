+		"timer owed %u dropped %u keys %u mouse %u/%u io %u snap %u us "
+		"valid %08x %08x %08x %08x \"%s\" \"%s\"\n",
+		why, vnow_us() / 1e6, v[PP_I_MAGIC], v[PP_I_VERSION], v[PP_I_SNAPSHOTS],
