+/* v4.0: the screen as the periodic drawing has left it, held against every
+   pixel worked out again (full_update 1).  A difference is a store into
+   video memory that the drawing was not told of (VGA_DIRTY_BLOCKS: a
+   block not marked).  The screen is left as the full redraw leaves it,
+   which is what it should have been.  The caller holds vga_lock. */
+static uint64_t audit_pics, audit_bad, audit_worst;
+static uint64_t draw_us;                /* host time in the periodic pc_vga_step() */
+static long audit_screen(void)
+{
+	static uint8_t *copy;
+	size_t bytes = (size_t) fb_w * fb_h * (BPP / 8);
+	if (!copy)
+		copy = malloc(bytes);
+	memcpy(copy, fb, bytes);
+	in_snapshot = 1;
+	vga_refresh(g_pc->vga, redraw, NULL, 1);
+	in_snapshot = 0;
+	long diff = 0;
+	for (size_t i = 0; i < bytes; i += BPP / 8)
+		diff += memcmp(copy + i, fb + i, BPP / 8) != 0;
+	audit_pics++;
+	if (diff) {
+		audit_bad++;
+		if ((uint64_t) diff > audit_worst)
+			audit_worst = diff;
+	}
+	return diff;
+}
