+static uint64_t tot_vrows, tot_vpx, tot_vbytes;
+static struct win wins[WIN_N];
+static int n_wins = -1, cur_win = -1;
+static void win_init(void)
+{
+	n_wins = 0;
+	const char *e = getenv("PCR_WIN");
+	while (e && *e && n_wins < WIN_N) {
+		double a, c;
+		int used = 0;
+		if (sscanf(e, "%lf:%lf%n", &a, &c, &used) != 2)
+			break;
+		wins[n_wins].t0 = a;
+		wins[n_wins].t1 = c;
+		n_wins++;
+		e += used;
+		if (*e == ',')
+			e++;
+	}
+}
+static void win_at(uint64_t t)
+{
+	if (n_wins < 0)
+		win_init();
+	cur_win = -1;
+	for (int i = 0; i < n_wins; i++)
+		if (t >= wins[i].t0 * 1e6 && t < wins[i].t1 * 1e6) {
+			cur_win = i;
+			break;
+		}
+}
+void pcr_vread(uint32_t n)
+{
+	if (cur_win >= 0 && pthread_equal(pthread_self(), main_thread)) {
+		wins[cur_win].lfb_r++;
+		wins[cur_win].lfb_rbytes += n;
+	}
+}
+void pcr_vrow(int n, int bpp)
+{
+	if (in_reference || in_snapshot)
+		return;
+	uint64_t bytes = (uint64_t) n * (bpp == 15 ? 2 : bpp / 8);
+	tot_vrows++;
+	tot_vpx += n;
+	tot_vbytes += bytes;
+	if (cur_win >= 0) {
+		wins[cur_win].vrows++;
+		wins[cur_win].vpx += n;
+		wins[cur_win].vbytes += bytes;
+	}
+}
+void pcr_vcall(int kind)
+{
+	if (cur_win >= 0 && pthread_equal(pthread_self(), main_thread) && kind >= 0 && kind <= 8)
+		wins[cur_win].vcall[kind]++;
+}
