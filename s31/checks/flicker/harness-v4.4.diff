+/* v4.4: PCR_WIN=T0:T1,T2:T3,... (virtual seconds, up to 16): for each window the guest's
+   instructions and halted steps, its stores into the linear frame buffer (count by size and
+   bytes), its reads of it (count and bytes), its calls of the VGA window's four store
+   functions, and the pictures drawn there with their host time and the rows flushed */
+#define WIN_N 16
+struct win {
+	double t0, t1;
+	uint64_t insns, halted, lfb_w[5], lfb_wbytes, lfb_r, lfb_rbytes, vcall[9];
+	uint64_t pics, draw_us, rows, pics_changed;
