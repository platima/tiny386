diff -ruN a/harness/instr_v44.py harness/instr_v44.py
--- a/harness/instr_v44.py	1970-01-01 08:00:00.000000000 +0800
+++ b/harness/instr_v44.py	2026-10-24 10:59:53.756501975 +0800
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+# instr_v44.py PC_C VGA_C: v4.4's counters for the flicker harness, put into the COPIES of
+# pc.c and vga.c (build.sh's src/): every read of the linear frame buffer (pcr_vread(n),
+# the three fast paths and iomem_read8's), every call of the four stores through the
+# VGA window (pcr_vcall(kind): 1 vga_mem_write, 2 vga_mem_write16, 4 vga_mem_write32,
+# 8 vga_mem_write_string), at the top of each, and the pixels each converted row of a VBE
+# picture covers (pcr_vrow(n, bpp) at the top of vbe_row(), where there is one).  Counted
+# per window (PCR_WIN) by headless.c.
+import re, sys
+
+pc, vga = sys.argv[1], sys.argv[2]
+src = open(pc).read()
+k = src.index('#include "pc.h"\n') + len('#include "pc.h"\n')
+src = src[:k] + 'void pcr_vread(uint32_t n);   /* flicker harness, v4.4 */\n' + src[k:]
+n = 0
+for stmt, ln in (('return pc->vga_mem[addr];', '1'),
+                 ('return ldu16((uint8_t *) &(pc->vga_mem[addr - vga_addr2]));', '2'),
+                 ('return ldu32((uint8_t *) &(pc->vga_mem[addr - vga_addr2]));', '4')):
+    pat = re.compile(r'^([ \t]*)' + re.escape(stmt) + r'\n', re.M)
+    m = pat.search(src)
+    if not m:
+        sys.exit('instr_v44.py: no "%s" in pc.c' % stmt)
+    src = src[:m.start()] + '%s{ pcr_vread(%s); %s }\n' % (m.group(1), ln, stmt) + src[m.end():]
+    n += 1
+open(pc, 'w').write(src)
+
+src = open(vga).read()
+k = src.index('#include "unaligned.h"\n') + len('#include "unaligned.h"\n')
+src = src[:k] + ('void pcr_vcall(int kind);   /* flicker harness, v4.4 */\n'
+                 'void pcr_vrow(int n, int bpp);\n') + src[k:]
+m_ = 0
+for sig, kind in (('void IRAM_ATTR vga_mem_write16(VGAState *s, uint32_t addr, uint16_t val16)\n{\n', 2),
+                  ('void IRAM_ATTR vga_mem_write32(VGAState *s, uint32_t addr, uint32_t val)\n{\n', 4),
+                  ('bool IRAM_ATTR vga_mem_write_string(VGAState *s, uint32_t addr, uint8_t *buf, int len)\n{\n', 8),
+                  ('void IRAM_ATTR vga_mem_write(VGAState *s, uint32_t addr, uint8_t val8)\n{\n', 1)):
+    if src.count(sig) != 1:
+        sys.exit('instr_v44.py: no "%s" in vga.c' % sig.split('(')[0])
+    src = src.replace(sig, sig + '    pcr_vcall(%d);\n' % kind)
+    m_ += 1
+sig = ('static bool vbe_row(uint32_t *d, const uint32_t *p, int n, int bpp,\n'
+       '                    const uint32_t *palette)\n{\n')
+nv = 0
+if src.count(sig) == 1:
+    src = src.replace(sig, sig + '    pcr_vrow(n, bpp);\n')
+    nv = 1
+open(vga, 'w').write(src)
+print("instr_v44.py: %d reads of the linear frame buffer and %d window store functions counted, "
+      "vbe_row %s" % (n, m_, "counted" if nv else "not there"))
