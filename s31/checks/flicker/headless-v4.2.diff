+/* v4.2's runs: PCR_EIPHIST=T0,T1 (virtual seconds) counts the guest's
+   instructions by where its CS:EIP was at the end of each step (CS and the
+   256 bytes of EIP), and prints the 40 places that took most at the end */
+#define EH_N 65536
+static struct { uint64_t key; uint64_t n; } eh_tab[EH_N];
+static int eh_on = -1;
+static double eh_t0, eh_t1;
+static uint64_t eh_total, eh_lost;
+static void eiphist_step(uint64_t t, uint64_t d)
+{
+	if (eh_on < 0) {
+		const char *e = getenv("PCR_EIPHIST");
+		eh_on = e && sscanf(e, "%lf,%lf", &eh_t0, &eh_t1) == 2;
+	}
+	if (!eh_on || !d || t < eh_t0 * 1e6 || t >= eh_t1 * 1e6)
+		return;
+	CPUI386_State st;
+	cpui386_get_state(g_pc->cpu, &st);
+	uint64_t key = ((uint64_t) (st.seg[1] & 0xffff) << 32) | (st.ip >> 8);
+	uint32_t h = (uint32_t) ((key * 0x9E3779B97F4A7C15ull) >> 40) % EH_N;
+	for (int i = 0; i < 64; i++, h = (h + 1) % EH_N) {
+		if (eh_tab[h].n == 0 || eh_tab[h].key == key) {
+			eh_tab[h].key = key;
+			eh_tab[h].n += d;
+			eh_total += d;
+			return;
+		}
+	}
+	eh_lost += d;
+}
+static int eh_cmp(const void *a, const void *b)
+{
+	uint64_t x = ((const typeof(eh_tab[0]) *) a)->n, y = ((const typeof(eh_tab[0]) *) b)->n;
+	return x < y ? 1 : x > y ? -1 : 0;
+}
+static void eiphist_print(void)
+{
+	if (eh_on <= 0)
+		return;
+	qsort(eh_tab, EH_N, sizeof(eh_tab[0]), eh_cmp);
+	fprintf(hout, "[harness] eiphist: %llu guest instructions from %.1f to %.1f s (%llu not placed)\n",
+		(unsigned long long) eh_total, eh_t0, eh_t1, (unsigned long long) eh_lost);
+	for (int i = 0; i < 40 && eh_tab[i].n; i++)
+		fprintf(hout, "[harness] eiphist: cs %04x eip %06xxx: %llu (%.1f %%)\n",
+			(unsigned) (eh_tab[i].key >> 32), (unsigned) (eh_tab[i].key & 0xffffff),
+			(unsigned long long) eh_tab[i].n, 100.0 * eh_tab[i].n / (eh_total ? eh_total : 1));
+}
