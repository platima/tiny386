From 007945125db73db5759cdc30bd2032957e34fb13 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Adam=20M=C3=BAdry?= <adam.mudry@espressif.com>
Date: Mon, 12 Oct 2026 13:48:45 +0200
Subject: [PATCH] fix(sdmmc): Dont overwrite CMD25 err with ACMD22 result in
 sdmmc_write_sectors_dma

Closes https://github.com/espressif/esp-idf/issues/19167
---
 components/sdmmc/sdmmc_cmd.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/components/sdmmc/sdmmc_cmd.c b/components/sdmmc/sdmmc_cmd.c
index ad0def625ff8..977f358d82af 100644
--- a/components/sdmmc/sdmmc_cmd.c
+++ b/components/sdmmc/sdmmc_cmd.c
@@ -593,11 +593,11 @@ esp_err_t sdmmc_write_sectors_dma(sdmmc_card_t* card, const void* src,
                 vTaskDelay(1); // when the host is in spi mode
             }
             size_t successfully_written_blocks = 0;
-            err = sdmmc_send_cmd_num_of_written_blocks(card, &successfully_written_blocks);
-            if (err == ESP_OK) {
+            esp_err_t err_acmd22 = sdmmc_send_cmd_num_of_written_blocks(card, &successfully_written_blocks);
+            if (err_acmd22 == ESP_OK) {
                 ESP_LOGD(TAG, "%s: successfully wrote %zu blocks out of %zu", __func__, successfully_written_blocks, block_count);
             } else {
-                ESP_LOGE(TAG, "%s: sdmmc_send_cmd_num_of_written_blocks returned 0x%x", __func__, err);
+                ESP_LOGE(TAG, "%s: sdmmc_send_cmd_num_of_written_blocks returned 0x%x", __func__, err_acmd22);
             }
         }
         if (err_cmd13 == ESP_OK) {
